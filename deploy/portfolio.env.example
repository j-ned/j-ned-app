# Variables de production du VPS. Modèle sans valeur : le copier hors du dépôt, sur le serveur
# (par exemple /opt/portfolio/portfolio.env, chmod 600, propriétaire root), puis le remplir.
# Le fichier rempli ne se versionne jamais et ne se colle ni dans une issue ni dans un journal de CI.

# --- Postgres (conteneur) -------------------------------------------------------------------------
POSTGRES_USER=portfolio
POSTGRES_DB=portfolio
# openssl rand -base64 32
POSTGRES_PASSWORD=

# --- API --------------------------------------------------------------------------------------------
NODE_ENV=production
# Hors Vercel, c'est cette variable qui déclare la production : mail et stockage deviennent
# obligatoires au démarrage, le seed de démo est refusé.
APP_ENV=production
PORT=3000
# postgres://portfolio:<POSTGRES_PASSWORD>@postgres:5432/portfolio (réseau interne du compose)
DATABASE_URL=
# Garder celui de Vercel pour ne pas déconnecter les sessions, ou en créer un : openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d
TOTP_APP_NAME=J-Ned Portfolio
CORS_ORIGINS=https://nedellec-julien.fr
# openssl rand -hex 32 ; le minuteur du VPS l'envoie à /api/cron/daily (Authorization: Bearer …)
CRON_SECRET=

# Stockage de fichiers (Cloudflare R2) : mêmes valeurs que sur Vercel
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Mail (Resend) : mêmes valeurs que sur Vercel
RESEND_API_KEY=
MAIL_FROM=

# Sentry : facultatif, un DSN vide laisse Sentry éteint
SENTRY_DSN=
SENTRY_FRONTEND_DSN=
SENTRY_TRACES_SAMPLE_RATE=

# --- Partagé par l'API et le rendu du site ----------------------------------------------------------
# openssl rand -hex 32 ; sans lui l'API ignore l'IP du visiteur transmise par le rendu
SSR_FORWARD_SECRET=

# --- Rendu du site ----------------------------------------------------------------------------------
API_UPSTREAM=http://api:3000
# En-tête où le proxy placé devant le rendu écrit l'IP du visiteur. À ne déclarer que si ce proxy
# l'écrase toujours : sinon un visiteur choisit son adresse, donc son quota.
VISITOR_IP_HEADER=x-real-ip
