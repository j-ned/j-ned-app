# Variables de production de la pile `deploy/compose.yaml`. Modèle sans valeur : coller le contenu
# rempli dans l'onglet Environment du service Compose de Dokploy, qui l'écrit dans le `.env` voisin
# du compose. Le fichier rempli ne se versionne jamais et ne se colle ni dans une issue ni dans un
# journal de CI. Une variable facultative se laisse commentée : vide, l'API la refuserait.

# --- Postgres -------------------------------------------------------------------------------------
POSTGRES_USER=portfolio
POSTGRES_DB=portfolio
# openssl rand -hex 32 (hexadécimal : la valeur entre telle quelle dans l'URL de connexion)
POSTGRES_PASSWORD=

# --- API --------------------------------------------------------------------------------------------
# Garder celui de Vercel pour ne pas déconnecter les sessions, ou en créer un : openssl rand -base64 48
JWT_SECRET=
CORS_ORIGINS=https://nedellec-julien.fr
# openssl rand -hex 32 ; envoyé chaque nuit par le service `portfolio-cron` à /api/cron/daily
CRON_SECRET=
# JWT_EXPIRES_IN=7d
# TOTP_APP_NAME=J-Ned Portfolio

# Stockage de fichiers (Cloudflare R2) : mêmes valeurs que sur Vercel
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Mail (Resend) : mêmes valeurs que sur Vercel
RESEND_API_KEY=
MAIL_FROM=

# Sentry : facultatif
# SENTRY_DSN=
# SENTRY_FRONTEND_DSN=
# SENTRY_TRACES_SAMPLE_RATE=

# --- Partagé par l'API et le rendu du site ----------------------------------------------------------
# openssl rand -hex 32 ; sans lui l'API ignore l'IP du visiteur transmise par le rendu
SSR_FORWARD_SECRET=

# --- Sauvegardes de la base -------------------------------------------------------------------------
# Bucket R2 privé, distinct de celui des fichiers, avec un jeton d'API limité à ce bucket.
# https://<identifiant de compte>.r2.cloudflarestorage.com, sans `/` final
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=portfolio-backups
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# openssl rand -base64 48 ; à conserver aussi hors du serveur (gestionnaire de mots de passe) :
# sans elle, aucune sauvegarde ne se déchiffre.
BACKUP_PASSPHRASE=

# --- Retour à une version (facultatif) --------------------------------------------------------------
# WEB_IMAGE=ghcr.io/j-ned/j-ned-app-web:sha-<commit>
# API_IMAGE=ghcr.io/j-ned/j-ned-app-api:sha-<commit>
