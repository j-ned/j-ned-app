# Contexte de build : la racine du monorepo. Seuls les manifestes du workspace et apps/api entrent.
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!.npmrc
!apps/api

# Dependencies
**/node_modules
**/.pnpm-store

# Build output
apps/api/dist
apps/api/coverage
apps/api/.nyc_output

# Tests (rebuilt si besoin, jamais copiés dans l'image)
apps/api/test
apps/api/**/*.spec.ts
apps/api/**/*.test.ts

# Local dev infra
apps/api/compose.yaml
apps/api/scripts

# Env (jamais dans l'image — injecté par Dokploy)
apps/api/.env
apps/api/.env.*
!apps/api/.env.example

# IDE
apps/api/.idea
apps/api/.vscode
apps/api/.history

# Docs
apps/api/docs
apps/api/**/*.md

# Logs / OS
apps/api/**/*.log
apps/api/**/.DS_Store

# Claude / superpowers
apps/api/.claude
apps/api/.remember
