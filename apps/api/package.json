{
  "name": "@portfolio/api",
  "version": "0.0.1",
  "description": "API Hono du portfolio nedellec-julien.fr : auth JWT + 2FA, blog, projets, contact, CV, analytics",
  "author": "Julien Nédellec <contact@nedellec-julien.fr> (https://nedellec-julien.fr)",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,test}/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node --enable-source-maps dist/main.js",
    "start:dev": "pnpm build && (pnpm build:watch & node --watch-path=./dist --enable-source-maps dist/main.js)",
    "start:prod": "node dist/main.js",
    "dev": "pnpm start:dev",
    "predev": "pnpm db:up && pnpm db:wait",
    "db:up": "podman compose up -d postgres",
    "db:down": "podman compose down postgres",
    "db:reset": "podman compose down -v postgres && pnpm db:up && pnpm db:wait && pnpm db:migrate && pnpm db:seed",
    "db:wait": "until podman exec portfolio-nest-db pg_isready -U portfolio -d portfolio_nest > /dev/null 2>&1; do sleep 0.5; done",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/database/seeds/admin.seed.ts",
    "db:change-password": "tsx src/database/scripts/change-password.ts",
    "db:studio": "drizzle-kit studio",
    "test": "node --experimental-vm-modules --no-warnings=ExperimentalWarning ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules --no-warnings=ExperimentalWarning ./node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules --no-warnings=ExperimentalWarning ./node_modules/jest/bin/jest.js --coverage",
    "build:watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "build:vercel": "rm -rf dist && tsc --noEmit -p tsconfig.build.json && node scripts/build-vercel.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@hono/node-server": "^2.1.5",
    "@sentry/node": "11.6.0",
    "@vercel/functions": "3.10.6",
    "argon2": "^0.44.0",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "file-type": "^22.2.0",
    "hono": "^4.13.16",
    "isbot": "^5.2.2",
    "jsonwebtoken": "^9.0.3",
    "otplib": "^13.5.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "sharp": "0.35.5",
    "tsx": "^4.23.15",
    "ua-parser-js": "^2.0.10",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@smithy/util-stream": "^4.8.2",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/ua-parser-js": "^0.7.39",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.14",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "globalSetup": "<rootDir>/../test/jest-global-setup.ts",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": {
            "moduleResolution": "node",
            "module": "commonjs",
            "resolvePackageJsonExports": false
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
