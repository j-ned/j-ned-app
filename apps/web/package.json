{
  "name": "@portfolio/web",
  "version": "0.0.0",
  "description": "Portfolio de Julien Nédellec : Angular 22 zoneless en SSR et prérendu, clean architecture, Signal Forms, Tailwind v4",
  "author": "Julien Nédellec <contact@nedellec-julien.fr> (https://nedellec-julien.fr)",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "icons:build": "tsx scripts/build-icons.mjs",
    "icons:check": "tsx scripts/build-icons.mjs --check",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "a11y": "playwright test -c e2e/playwright.config.ts",
    "a11y:typecheck": "tsc -p e2e/tsconfig.json",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write \"src/**/*.{ts,html,css,scss,json}\" \"e2e/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,scss,json}\" \"e2e/**/*.ts\"",
    "check": "pnpm run format:check && pnpm run lint",
    "postbuild": "tsx scripts/apply-csp-hashes.mjs"
  },
  "lint-staged": {
    "*.ts": [
      "pnpm exec prettier --write",
      "pnpm exec eslint --fix"
    ],
    "*.html": [
      "pnpm exec prettier --write",
      "pnpm exec eslint --fix"
    ],
    "*.{css,scss,json}": [
      "pnpm exec prettier --write"
    ]
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "26.x"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.8.0",
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/platform-server": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@angular/ssr": "^22.3.0",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.6",
    "angular-eslint": "22.8.0",
    "chart.js": "^4.6.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "20.14.6",
    "postcss": "8.5.33",
    "prettier": "^3.10.1",
    "rxjs": "~7.8.2",
    "svg-sprite": "^2.0.4",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.5",
    "tslib": "^2.9.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@sentry/angular": "^11.16.0",
    "highlight.js": "11.12.0",
    "isomorphic-dompurify": "4.8.0",
    "jsdom": "^30.1.3",
    "marked": "^18.2.1"
  }
}
